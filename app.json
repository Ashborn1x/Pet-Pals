{
  "expo": {
    "name": "PetPals",
    "slug": "PetPals",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./src/assets/icons/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/icons/android-icon-foreground.png",
        "backgroundImage": "./src/assets/icons/android-icon-background.png",
        "monochromeImage": "./src/assets/icons/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ashborn1.PetPals"
    },
    "web": {
      "favicon": "./src/assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PetPals to use your photos for pet profiles.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "a2a2cc1f-319f-4423-bdee-46aa3bf4a0db"
      }
    }
  }
}
